<Window x:Class="Denpa3SavEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Denpa3SavEditor"
        Icon="/Assets/icon.ico"
        mc:Ignorable="d"
        Title="電波人間のRPG3　電波人間クリエイター" Height="500" Width="800">

    <!-- ボタンとかスタイル -->
    <Window.Resources>

        <Style x:Key="IconButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                      x:Name="ButtonBorder"
                      CornerRadius="50"
                      ClipToBounds="True"
                      Background="{TemplateBinding Background}">

                            <ContentPresenter
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- マウスを乗せたとき -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                              TargetName="ButtonBorder"
                              Property="Background"
                              Value="#22000000"/>
                            </Trigger>

                            <!-- 押しているとき -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                              TargetName="ButtonBorder"
                              Property="Background"
                              Value="#44000000"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="ButtonStyle" TargetType="{x:Type Button}">

            <Setter Property="Background" Value="#e0ffff"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border
                        x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8"
                        ClipToBounds="True">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                TargetName="ButtonBorder"
                                Property="Background"
                                Value="#22000000"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                TargetName="ButtonBorder"
                                Property="Background"
                                Value="#44000000"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>


        <Style x:Key="TabItemStyle" TargetType="{x:Type TabItem}">

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,6"/>
            <Setter Property="Margin" Value="2"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type TabItem}">

                        <Border
                    x:Name="TabBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ContentSource="Header"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- マウスを乗せた -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                            TargetName="TabBorder"
                            Property="Background"
                            Value="#DDDDDD"/>
                            </Trigger>

                            <!-- 選択中 -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter
                            TargetName="TabBorder"
                            Property="Background"
                            Value="#AAAAAA"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>



    </Window.Resources>


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="69*"/>
            <ColumnDefinition Width="91*"/>
        </Grid.ColumnDefinitions>

        <Button Content="ファイルを開く" Height="42" HorizontalAlignment="Left" Margin="12,12,0,0" Name="button1" VerticalAlignment="Top" Width="111" Click="button1_Click" Style="{StaticResource ButtonStyle}"  />
        <Button Content="上書き保存" Height="23" HorizontalAlignment="Left" Margin="128,12,0,0" Name="button2" VerticalAlignment="Top" Width="99" Click="button2_Click" Style="{StaticResource ButtonStyle}"   />

        <StackPanel Margin="16,68,0,313" Orientation="Horizontal" HorizontalAlignment="Left" Width="339" Grid.ColumnSpan="2">

            <TextBlock Text="所持金：" Height="18" Width="40" Margin="10" RenderTransformOrigin="0.424,2.112"/>
            <TextBox x:Name="MoneyTextBox" Width="97" Height="22"/>

            <TextBlock Text="ジュエル：" Height="18" Width="40" Margin="10"  RenderTransformOrigin="0.424,2.112"/>
            <TextBox x:Name="JewelTextBox" Width="100" Height="22"/>

        </StackPanel>

        <StackPanel Margin="16,185,0,10">

            <!-- なまえ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="なまえ：" Width="60" VerticalAlignment="Center"/>
                <TextBox x:Name="NameTextBox" TextChanged="ParametorTextBox_Changed" Width="118" Height="22"/>
                <TextBlock Text="性格：" Width="35" Margin="9" VerticalAlignment="Center"/>
                <ComboBox x:Name="PersonalityComboBox" SelectedValuePath="Key" SelectionChanged="PersonalityComboBox_SelectionChanged" Width="73" Height="24"/>
                <!--<TextBox x:Name="PersonalityTextBox" TextChanged="ParametorTextBox_Changed" Width="68" Height="22"/>-->
            </StackPanel>

            <!-- アンテナ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="アンテナ：" Width="60" VerticalAlignment="Center"/>
                <ComboBox x:Name="AntenaComboBox" SelectedValuePath="Key" SelectionChanged="AntenaComboBox_SelectionChanged" Width="118">


                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Value.Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                    <ComboBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock
                            Text="{Binding Name}"
                            FontWeight="Bold" FontSize="15"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ComboBox.GroupStyle>

                </ComboBox>

            </StackPanel>

            <Separator Margin="10" Height="22" Width="255"/>

            <TextBlock Text="体の色" Width="34" Margin="5"/>

            <!-- 色 -->
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled" Height="54" Width="272"
                >

                <ScrollViewer.Resources>

                    <Style TargetType="Thumb">
                        <Setter Property="Height" Value="10"/>
                        <Setter Property="Background" Value="#888888"/>
                    </Style>

                    <Style TargetType="ScrollBar">
                        <!-- 上のStyleをここに入れる -->
                        <Setter Property="Height" Value="4"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid>
                                        <Border
                Background="#DDDDDD"
                CornerRadius="4"/>

                                        <Track
                x:Name="PART_Track"
                IsDirectionReversed="False">

                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border
                                    Background="#888888"
                                    CornerRadius="4"
                                    Margin="0,1"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>

                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                </ScrollViewer.Resources>

                <StackPanel Orientation="Horizontal" x:Name="BodyColorPickPanel"/>

            </ScrollViewer>

            <!-- 前髪の色 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="髪の色：" Width="60" VerticalAlignment="Center"/>
                    <TextBox x:Name="HearColorTextBox" TextChanged="ParametorTextBox_Changed" Width="68" Height="22"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="肌の色：" Width="60" Margin="5" VerticalAlignment="Center"/>
                    <TextBox x:Name="SkinColorTextBox" TextChanged="ParametorTextBox_Changed" Width="67" Height="22"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <StackPanel Orientation="Horizontal" Margin="5">

                </StackPanel>
            </StackPanel>
            <Button Content="リセット" Height="23" x:Name="buttonParamReset" Width="102" Click="ParametorReset_Click" Style="{StaticResource ButtonStyle}"  RenderTransformOrigin="0.5,0.5" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <Button x:Name="BinaryEdit" Content="バイナリ" Width="50" Height="23" Click="EditButton_Click" Style="{StaticResource ButtonStyle}" />
             
                <!-- デバッグ用 -->
                <StackPanel Orientation="Horizontal" Margin="10,0,0,5" Visibility="Hidden">

                    <TextBlock Text="debug 値：" Width="60" VerticalAlignment="Center"/>
                    <TextBox x:Name="DebugTextBox" TextChanged="DebugTextBox_Changed" Width="82" Height="22"/>
                </StackPanel>
                
            </StackPanel>
        </StackPanel>

        <StackPanel Margin="10,119,269,15" Grid.Column="1" >
            <TabControl Height="248" Width="172" ItemContainerStyle="{StaticResource TabItemStyle}">


                <TabItem Header="目">

                    <!-- スクロールバー -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible">



                        <WrapPanel x:Name="FacePartsEyePanel" Width="138"/>

                    </ScrollViewer>

                </TabItem>

                <TabItem Header="まゆげ">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="FacePartsEyebrowPanel" Width="138"/>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="鼻">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="FacePartsNosePanel" Width="138"/>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="口">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="FacePartsMouthPanel" Width="138"/>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="ほっぺ">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="FacePartsCheekPanel" Width="138"/>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="めがね">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="FacePartsCoverPanel" Width="138"/>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="前髪">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="FacePartsForelockPanel" Width="138"/>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="輪郭">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="FacePartsFaceOutlinePanel" Width="138"/>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="頭">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="FacePartsFaceHeadPanel" Width="138"/>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
            <Button Content="リセット" Height="23" x:Name="buttonFaceReset" Width="88" Click="FaceReset_Click" Style="{StaticResource ButtonStyle}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Grid.Column="1" Margin="207,103,11,0" Height="324">

            <Canvas x:Name="DrawCanvas"
                Background="Transparent" Margin="5,0,0,0" Width="189" Height="252" >
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Canvas.RenderTransform>
            </Canvas>

            <Slider
                x:Name="BodyHeightSlider"
                Width="33"
                TickPlacement="Both"
                Margin="10"
                ValueChanged="BodyHeightSliderValueChanged"
                    
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    
               Orientation="Vertical"
               Height="228"/>

        </StackPanel>

        <!-- デバッグ用-->
        <TextBlock x:Name="bodyHeight" Visibility="Hidden" VerticalAlignment="Top" Grid.Column="1" Margin="289,386,80,0" Height="26" />

        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Grid.Column="1" Margin="191,28,13,0" Height="70">

            <!-- 表示モード -->
            <TextBlock Text="表示：" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <!-- 左 -->
            <Button x:Name="leftButton" Content="＜" Width="31" Height="28" Click="LeftButton_Click" Style="{StaticResource ButtonStyle}" />
            <!-- 現在の表示 -->
            <TextBlock x:Name="CurrentPreviewModeView" Width="80" VerticalAlignment="Center" TextAlignment="Center"/>
            <!-- 右 -->
            <Button x:Name="rightButton" Content="＞" Width="31" Height="28" Click="RightButton_Click" Style="{StaticResource ButtonStyle}" />
            <!-- 切り替え -->
            <Button x:Name="buttonChangeViewMode" Content="切り替え" Width="53" Height="28" Margin="8,0,0,0" Click="ChangeViewMode_Click" Style="{StaticResource ButtonStyle}" />
        </StackPanel>


    </Grid>


</Window>
